# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.

# Endereço do banco PostgreSQL.
# No Render: use a "Internal Database URL" do banco (o render.yaml já preenche sozinho).
# No computador: postgres://usuario:senha@localhost:5432/promotor
DATABASE_URL=

# Segredo da sessão de login (mínimo 32 caracteres; obrigatório em produção).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Primeiro usuário (perfil suporte): criado ao iniciar, só se ainda não houver nenhum usuário.
# Depois de criado, pode apagar ADMIN_SENHA.
# ADMIN_LOGIN=
# ADMIN_NOME=
# ADMIN_SENHA=

# Opcionais
# PORT=3000
# META_PERCENTUAL=3
